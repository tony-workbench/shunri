# Google Calendar settings. Copy this file to .env and fill in the client ID and secret.
# Create them in Google Cloud Console: APIs & Services > Credentials > OAuth client (Web application).
# Enable the Google Calendar API, add the redirect URI below exactly, and add your own
# Google account as a test user while the OAuth consent screen is in Testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
# Leave false to keep the app from creating or changing events in Google Calendar.
CALENDAR_WRITES_ENABLED=false
